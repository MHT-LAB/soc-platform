# One encrypted database backup (deploy/backup.sh). Started by soc-backup.timer; run it by
# hand with `systemctl start soc-backup.service`, read the result with
# `journalctl -u soc-backup.service -n 20`. Install: see docs/runbooks/database.md.
[Unit]
Description=SOC database backup (encrypted dump)
After=docker.service
Requires=docker.service
# A backup that finished well starts the off-site copy (soc-offsite.service, which does
# nothing on a host without env/offsite.env). A failed backup sends nothing.
OnSuccess=soc-offsite.service

[Service]
Type=oneshot
ExecStart=/opt/soc-platform/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
